generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum BusinessType {
  REAL_ESTATE
  ADVERTISING
  RETAIL
  CONSTRUCTION
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  OTHER
}

enum CompanyType {
  CORPORATION
  LLC
  SOLE_PROPRIETOR
  PARTNERSHIP
  NON_PROFIT
  OTHER
}

enum CycleType {
  DAYS
  MONTHLY_DATE
  WEEKLY_DAY
  MONTHLY_WEEKDAY
  QUARTERLY
  YEARLY
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments   Assignment[]
  faceImages    FaceImage[]
}

model FaceImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  luxandId  String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], map: "fk_face_image_user")
}

// ─── Company & related sub-tables ────────────────────────────────────────────

model Company {
  id              Int           @id @default(autoincrement())
  businessName    String
  supportNumber   String?       @unique
  businessType    BusinessType?
  companyType     CompanyType?
  companyActivity String?       @db.Text
  country         String?
  qbPlan          String?
  status          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  legalInfo     LegalInfo?
  contactInfo   ContactInfo?
  billing       Billing?
  accountant    Accountant?
  gmailAccount  GmailAccount?
  assignments   Assignment[]
  todos         Todo[]
  taskSchedules TaskSchedule[]
  links         Link[]
  notes         CompanyNote[]
  chatReadStates ChatReadState[]
}

model LegalInfo {
  id          Int      @id @default(autoincrement())
  companyId   Int      @unique
  neq         String?
  revenueQcId String?
  craBn       String?
  fiscalYear  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_legal_info_company")
}

model ContactInfo {
  id           Int      @id @default(autoincrement())
  companyId    Int      @unique
  privateEmail String?
  privatePhone String?
  personalName String?
  storeNumber  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_contact_info_company")
}

model Billing {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  billingEmail    String?
  billingPassword String? // stored AES-256 encrypted — never plaintext
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_billing_company")
}

model Accountant {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_accountant_company")
}

// ─── Assignments (User ↔ Company) ────────────────────────────────────────────

model Assignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  companyId  Int
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], map: "fk_assignment_user")
  company Company @relation(fields: [companyId], references: [id], map: "fk_assignment_company")

  @@unique([userId, companyId])
}

// ─── Tasks & Todos ───────────────────────────────────────────────────────────

model Task {
  id                Int       @id @default(autoincrement())
  title             String    @unique
  description       String?   @db.Text
  note              String?   @db.Text
  isGeneral         Boolean   @default(false)
  defaultCycle      Int       @default(30)
  defaultCycleType  CycleType @default(DAYS)
  defaultCycleDay   Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  defaultCycleNth   Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  isImportant       Boolean   @default(false)
  canBeDisabled     Boolean   @default(false)
  isSnoozable       Boolean   @default(false)
  orderNumber       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  todos     Todo[]
  schedules TaskSchedule[]
}

// Recurring schedule for a task assigned to a company.
// cycleType determines recurrence pattern; cycle is only used for DAYS type.
// deletedAt = soft-delete: stops future todo generation without deleting history.
model TaskSchedule {
  id          Int       @id @default(autoincrement())
  taskId      Int
  companyId   Int
  cycle       Int       @default(30) // days between recurrences (DAYS type only)
  cycleType   CycleType @default(DAYS)
  cycleDay    Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  cycleNth    Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  note        String?   @db.Text
  userNote    String?   @db.Text
  isImportant     Boolean   @default(false)
  isManuallyAdded Boolean   @default(false)
  startDate       DateTime?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  task    Task         @relation(fields: [taskId], references: [id], map: "fk_schedule_task")
  company Company      @relation(fields: [companyId], references: [id], map: "fk_schedule_company")
  todos   Todo[]
}

// ─── Company Notes ───────────────────────────────────────────────────────────

model CompanyNote {
  id        Int      @id @default(autoincrement())
  companyId Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_company_note_company")
}

// ─── Links ───────────────────────────────────────────────────────────────────

model Link {
  id        Int    @id @default(autoincrement())
  companyId Int
  label     String
  url       String

  company Company @relation(fields: [companyId], references: [id], map: "fk_link_company")
}


// ─── Gmail Integration ───────────────────────────────────────────────────────

model GmailAccount {
  id            Int       @id @default(autoincrement())
  companyId     Int       @unique
  gmailAddress  String
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  tokenExpiry   DateTime
  lastHistoryId BigInt?
  watchExpiry   DateTime?
  connectedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_gmail_account_company")
}

// Shared read/unread state for a Google Chat conversation (space), per company.
// A conversation is READ iff its latest message createTime <= lastReadAt.
// Shared across all users — when one user reads a chat it is read for everyone,
// like the shared mailbox. No row = unread.
model ChatReadState {
  id         Int      @id @default(autoincrement())
  companyId  Int
  spaceId    String   // Google Chat space resource name, e.g. "spaces/AAAA"
  lastReadAt DateTime
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_chat_read_state_company")

  @@unique([companyId, spaceId], map: "uq_chat_read_state_company_space")
}

// Individual todo instance. scheduleId is set when generated by a TaskSchedule.
// Standalone (one-time) todos have scheduleId = null.
model Todo {
  id         Int       @id @default(autoincrement())
  taskId     Int
  companyId  Int
  scheduleId Int?
  dueDate    DateTime?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     Task          @relation(fields: [taskId], references: [id], map: "fk_todo_task")
  company  Company       @relation(fields: [companyId], references: [id], map: "fk_todo_company")
  schedule TaskSchedule? @relation(fields: [scheduleId], references: [id], map: "fk_todo_schedule")
}

