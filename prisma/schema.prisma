generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum BusinessType {
  REAL_ESTATE
  ADVERTISING
  RETAIL
  CONSTRUCTION
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  OTHER
}

enum CompanyType {
  CORPORATION
  LLC
  SOLE_PROPRIETOR
  PARTNERSHIP
  NON_PROFIT
  OTHER
}

enum CycleType {
  DAYS
  MONTHLY_DATE
  WEEKLY_DAY
  MONTHLY_WEEKDAY
  QUARTERLY
  YEARLY
}

// How an internal message was addressed to a given recipient.
enum InternalRecipientKind {
  TO
  CC
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments   Assignment[]
  faceSubject   FaceSubject?

  // The user's private "Cyg Finance" workspace (a Company row flagged isInternal).
  // Created automatically with the user; see CompaniesService.ensureInternalWorkspace.
  internalWorkspace Company? @relation("InternalWorkspace")

  sentInternalMessages     InternalMessage[]
  internalMessagesReceived InternalMessageRecipient[]
}

/// The one Luxand identity a user has. `subjectId` is the person uuid returned by
/// POST /v2/person, and that single person holds all three enrolment photos.
///
/// Replaces the old FaceImage table, which stored one row -- and one separate
/// Luxand subject -- per photo. That made every user three competing identities in
/// a global gallery, which is what made login slow and matching unreliable.
model FaceSubject {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  subjectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], map: "fk_face_subject_user")
}

// ─── Company & related sub-tables ────────────────────────────────────────────

model Company {
  id              Int           @id @default(autoincrement())
  businessName    String
  supportNumber   String?       @unique
  businessType    BusinessType?
  companyType     CompanyType?
  companyActivity String?       @db.Text
  country         String?
  qbPlan          String?
  status          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // ── Internal "Cyg Finance" workspace ──────────────────────────────────────
  // Not a real client company: it is the per-user container for the internal
  // messaging inbox and that user's private Links. Excluded from registration,
  // todos/schedules, assignment, archiving and permanent delete. internalOwnerId
  // is @unique, which is what caps it at exactly one workspace per user and makes
  // ensureInternalWorkspace's upsert race-safe.
  isInternal      Boolean @default(false)
  internalOwnerId Int?    @unique

  internalOwner User? @relation("InternalWorkspace", fields: [internalOwnerId], references: [id], map: "fk_company_internal_owner")

  legalInfo     LegalInfo?
  contactInfo   ContactInfo?
  billing       Billing?
  accountant    Accountant?
  gmailAccount  GmailAccount?
  microsoftAccount MicrosoftAccount?
  assignments   Assignment[]
  todos         Todo[]
  taskSchedules TaskSchedule[]
  links         Link[]
  notes         CompanyNote[]
  chatMessageReadStates ChatMessageReadState[]
  messageCompletedStates MessageCompletedState[]
  forwardedMessageStates ForwardedMessageState[]
}

model LegalInfo {
  id          Int      @id @default(autoincrement())
  companyId   Int      @unique
  neq         String?
  revenueQcId String?
  craBn       String?
  fiscalYear  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_legal_info_company")
}

model ContactInfo {
  id           Int      @id @default(autoincrement())
  companyId    Int      @unique
  privateEmail String?
  privatePhone String?
  personalName String?
  storeNumber  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_contact_info_company")
}

model Billing {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  billingEmail    String?
  billingPassword String? // stored AES-256 encrypted — never plaintext
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_billing_company")
}

model Accountant {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_accountant_company")
}

// ─── Assignments (User ↔ Company) ────────────────────────────────────────────

model Assignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  companyId  Int
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], map: "fk_assignment_user")
  company Company @relation(fields: [companyId], references: [id], map: "fk_assignment_company")

  @@unique([userId, companyId])
}

// ─── Tasks & Todos ───────────────────────────────────────────────────────────

model Task {
  id                Int       @id @default(autoincrement())
  title             String    @unique
  description       String?   @db.Text
  note              String?   @db.Text
  isGeneral         Boolean   @default(false)
  defaultCycle      Int       @default(30)
  defaultCycleType  CycleType @default(DAYS)
  defaultCycleDay   Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  defaultCycleNth   Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  isImportant       Boolean   @default(false)
  canBeDisabled     Boolean   @default(false)
  isSnoozable       Boolean   @default(false)
  orderNumber       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  todos     Todo[]
  schedules TaskSchedule[]
}

// Recurring schedule for a task assigned to a company.
// cycleType determines recurrence pattern; cycle is only used for DAYS type.
// deletedAt = soft-delete: stops future todo generation without deleting history.
model TaskSchedule {
  id          Int       @id @default(autoincrement())
  taskId      Int
  companyId   Int
  cycle       Int       @default(30) // days between recurrences (DAYS type only)
  cycleType   CycleType @default(DAYS)
  cycleDay    Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  cycleNth    Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  note        String?   @db.Text
  userNote    String?   @db.Text
  isImportant     Boolean   @default(false)
  isManuallyAdded Boolean   @default(false)
  startDate       DateTime?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  task    Task         @relation(fields: [taskId], references: [id], map: "fk_schedule_task")
  company Company      @relation(fields: [companyId], references: [id], map: "fk_schedule_company")
  todos   Todo[]
}

// ─── Company Notes ───────────────────────────────────────────────────────────

model CompanyNote {
  id        Int      @id @default(autoincrement())
  companyId Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_company_note_company")
}

// ─── Links ───────────────────────────────────────────────────────────────────

model Link {
  id        Int     @id @default(autoincrement())
  companyId Int
  label     String
  url       String  @db.Text
  username  String?
  password  String? // stored AES-256 encrypted (ivHex:cipherHex) — never plaintext
  note      String? @db.Text

  company Company @relation(fields: [companyId], references: [id], map: "fk_link_company")
}

// ─── Internal messaging (staff ↔ staff) ──────────────────────────────────────

// One internal message. Behaves like an email: it has a subject, an HTML body,
// attachments, and lives in a thread. Unlike the Communications tab (which reads
// live from Google/Microsoft and persists nothing), these messages ARE the store.
model InternalMessage {
  id        Int       @id @default(autoincrement())
  // Root message id of the conversation. Set to the message's own id right after
  // create for a new thread, or inherited from the parent for a reply/forward.
  threadId  Int?
  // The message this one replies to or forwards. Null for a fresh message.
  parentId  Int?
  senderId  Int
  subject   String    @db.Text
  bodyHtml  String?   @db.Text
  bodyText  String?   @db.Text
  isForward Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  sender      User                        @relation(fields: [senderId], references: [id], map: "fk_internal_message_sender")
  recipients  InternalMessageRecipient[]
  attachments InternalMessageAttachment[]

  @@index([threadId], map: "idx_internal_message_thread")
  @@index([senderId, createdAt], map: "idx_internal_message_sender")
}

// Per-recipient delivery + state. Read/completed live HERE rather than in a shared
// table (cf. ChatMessageReadState / MessageCompletedState, which are deliberately
// shared per company) because every user has their own private internal inbox.
model InternalMessageRecipient {
  id          Int                   @id @default(autoincrement())
  messageId   Int
  userId      Int
  kind        InternalRecipientKind @default(TO)
  readAt      DateTime?
  completedAt DateTime?

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "fk_internal_msg_recipient_message")
  user    User            @relation(fields: [userId], references: [id], map: "fk_internal_msg_recipient_user")

  @@unique([messageId, userId], map: "uq_internal_msg_recipient")
  @@index([userId, completedAt], map: "idx_internal_msg_recipient_inbox")
}

// Attachment bytes live on disk under UPLOADS_DIR (see internal-messages.service);
// only the metadata + relative storagePath are stored here. This is the first
// thing in the app that persists a user-supplied file — every other upload
// (face photos, email attachments) is a pass-through to an external API.
model InternalMessageAttachment {
  id          Int      @id @default(autoincrement())
  messageId   Int
  filename    String // original name as uploaded, shown in the UI
  mimeType    String
  size        Int
  storagePath String // path relative to the uploads root, e.g. "messages/<uuid>.pdf"
  createdAt   DateTime @default(now())

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "fk_internal_msg_attachment_message")

  @@index([messageId], map: "idx_internal_msg_attachment_message")
}

// ─── Gmail Integration ───────────────────────────────────────────────────────

model GmailAccount {
  id            Int       @id @default(autoincrement())
  companyId     Int       @unique
  gmailAddress  String
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  tokenExpiry   DateTime
  lastHistoryId BigInt?
  watchExpiry   DateTime?
  connectedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  chatUserId    String?   // connected account's own Google Chat user id (OIDC `sub`), used to hide self-sent messages from the inbox
  scope         String?   @db.Text // space-separated list of OAuth scopes Google actually granted on the last connect (used to detect missing chat.messages)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_gmail_account_company")
}

// Connected Microsoft (Outlook + Teams) account for a company — the Microsoft
// analog of GmailAccount. A company has AT MOST ONE communications account: a row
// here OR in GmailAccount, never both. Which table has the row IS the provider.
// Tokens are AES-256 encrypted at the app layer (same crypto as GmailAccount).
model MicrosoftAccount {
  id           Int       @id @default(autoincrement())
  companyId    Int       @unique
  emailAddress String
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  tokenExpiry  DateTime
  msUserId     String?   // Graph /me id — self-hide analog of GmailAccount.chatUserId (hides self-sent Teams messages)
  scope        String?   @db.Text // space-separated list of Graph scopes actually granted on the last connect
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_ms_account_company")
}

// Shared per-MESSAGE read/unread state for Google Chat, per company.
// A message is READ iff a row exists for it. Shared across all users — when one
// user reads a chat message it is read for everyone, like the shared mailbox.
model ChatMessageReadState {
  id        Int      @id @default(autoincrement())
  companyId Int
  // VarChar(500), not Prisma's default VARCHAR(191): provider message ids are far
  // longer than Gmail's ~16-char hex. Under STRICT_TRANS_TABLES an over-long value
  // is an error (1406), not a truncation, so the INSERT throws and the state is
  // silently lost. Index still fits: 4 (INT) + 500*4 = 2004 bytes < InnoDB's 3072.
  messageId String   @db.VarChar(500) // Google Chat message resource name, e.g. "spaces/A/messages/B"
  readAt    DateTime
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_chat_msg_read_state_company")

  @@unique([companyId, messageId], map: "uq_chat_msg_read_state")
}

// Shared per-MESSAGE "completed" state for the Communications inbox (email + chat),
// per company. A message is COMPLETED iff a row exists for it. Shared across all
// users — when one user marks a message complete it is complete for everyone.
// The messageId is a provider-namespaced message id: a Gmail message id (no
// slashes), a Google Chat resource name (e.g. "spaces/A/messages/B"), an Outlook
// message id, or a Teams chat message id prefixed "msteams:{chatId}:{messageId}".
// Namespacing keeps email and chat ids from colliding across providers.
model MessageCompletedState {
  id          Int      @id @default(autoincrement())
  companyId   Int
  // See ChatMessageReadState.messageId — VARCHAR(191) was too narrow for Outlook
  // restIds, so marking an Outlook email complete threw and appeared to "not stick".
  messageId   String   @db.VarChar(500)
  completedAt DateTime
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_msg_completed_state_company")

  @@unique([companyId, messageId], map: "uq_msg_completed_state")
}

// Shared per-company forward event log — one row per time an inbox message was
// forwarded (from within the app), carrying the recipient and the moment. A
// message forwarded N times has N rows; forwarded iff at least one row exists.
// Accessed via raw SQL in gmail.service.ts.
model ForwardedMessageState {
  id          Int      @id @default(autoincrement())
  companyId   Int
  // See ChatMessageReadState.messageId — same VARCHAR(191) ceiling.
  messageId   String   @db.VarChar(500)
  recipient   String?  @db.Text
  // Id of the NEW message that was sent for this forward (Gmail message id /
  // Outlook immutable message id). Lets the UI open the full sent forward.
  // Null for legacy rows recorded before this was captured.
  sentMessageId String? @db.Text
  forwardedAt DateTime
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_msg_forwarded_state_company")

  @@index([companyId, messageId], map: "idx_msg_forwarded_state")
}

// Individual todo instance. scheduleId is set when generated by a TaskSchedule.
// Standalone (one-time) todos have scheduleId = null.
model Todo {
  id         Int       @id @default(autoincrement())
  taskId     Int
  companyId  Int
  scheduleId Int?
  dueDate    DateTime?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     Task          @relation(fields: [taskId], references: [id], map: "fk_todo_task")
  company  Company       @relation(fields: [companyId], references: [id], map: "fk_todo_company")
  schedule TaskSchedule? @relation(fields: [scheduleId], references: [id], map: "fk_todo_schedule")
}

