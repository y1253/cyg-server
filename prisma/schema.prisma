generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  USER
}

enum BusinessType {
  REAL_ESTATE
  ADVERTISING
  RETAIL
  CONSTRUCTION
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  OTHER
}

enum CompanyType {
  CORPORATION
  LLC
  SOLE_PROPRIETOR
  PARTNERSHIP
  NON_PROFIT
  OTHER
}

enum CycleType {
  DAYS
  MONTHLY_DATE
  WEEKLY_DAY
  MONTHLY_WEEKDAY
  QUARTERLY
  YEARLY
}

// How an internal message was addressed to a given recipient.
//
// BCC rows are real recipient rows (so the message reaches the user's inbox and
// passes `visibleToViewer` like any other), but the service hides them from every
// viewer except the sender and the BCC'd user themselves.
enum InternalRecipientKind {
  TO
  CC
  BCC
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments   Assignment[]
  faceSubject   FaceSubject?

  // The user's private "Cyg Finance" workspace (a Company row flagged isInternal).
  // Created automatically with the user; see CompaniesService.ensureInternalWorkspace.
  internalWorkspace Company? @relation("InternalWorkspace")

  sentInternalMessages     InternalMessage[]
  internalMessagesReceived InternalMessageRecipient[]

  internalCallsMade     InternalCall[] @relation("InternalCallsMade")
  internalCallsReceived InternalCall[] @relation("InternalCallsReceived")
}

/// The one Luxand identity a user has. `subjectId` is the person uuid returned by
/// POST /v2/person, and that single person holds all three enrolment photos.
///
/// Replaces the old FaceImage table, which stored one row -- and one separate
/// Luxand subject -- per photo. That made every user three competing identities in
/// a global gallery, which is what made login slow and matching unreliable.
model FaceSubject {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  subjectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], map: "fk_face_subject_user")
}

// ─── Company & related sub-tables ────────────────────────────────────────────

model Company {
  id              Int           @id @default(autoincrement())
  businessName    String
  supportNumber   String?       @unique
  businessType    BusinessType?
  companyType     CompanyType?
  companyActivity String?       @db.Text
  country         String?
  qbPlan          String?
  status          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // ── Internal "Cyg Finance" workspace ──────────────────────────────────────
  // Not a real client company: it is the per-user container for the internal
  // messaging inbox and that user's private Links. Excluded from registration,
  // todos/schedules, assignment, archiving and permanent delete. internalOwnerId
  // is @unique, which is what caps it at exactly one workspace per user and makes
  // ensureInternalWorkspace's upsert race-safe.
  isInternal      Boolean @default(false)
  internalOwnerId Int?    @unique

  internalOwner User? @relation("InternalWorkspace", fields: [internalOwnerId], references: [id], map: "fk_company_internal_owner")

  legalInfo     LegalInfo?
  contactInfo   ContactInfo?
  billing       Billing?
  accountant    Accountant?
  gmailAccount  GmailAccount?
  microsoftAccount MicrosoftAccount?
  supportNumbers   SupportNumber[]
  phoneSettings CompanyPhoneSettings?
  assignments   Assignment[]
  todos         Todo[]
  taskSchedules TaskSchedule[]
  links         Link[]
  notes         CompanyNote[]
  chatMessageReadStates ChatMessageReadState[]
  messageCompletedStates MessageCompletedState[]
  forwardedMessageStates ForwardedMessageState[]
}

model LegalInfo {
  id          Int      @id @default(autoincrement())
  companyId   Int      @unique
  neq         String?
  revenueQcId String?
  craBn       String?
  fiscalYear  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_legal_info_company")
}

model ContactInfo {
  id           Int      @id @default(autoincrement())
  companyId    Int      @unique
  privateEmail String?
  privatePhone String?
  personalName String?
  storeNumber  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_contact_info_company")
}

model Billing {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  billingEmail    String?
  billingPassword String? // stored AES-256 encrypted — never plaintext
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_billing_company")
}

model Accountant {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_accountant_company")
}

/// The SignalWire number attached to a company. History is preserved: a company may hold
/// several numbers over its life, so this is 1:N with at most one ACTIVE row.
///
/// `Company.supportNumber` is a denormalised MIRROR of the active row’s `phoneNumber` --
/// the email-signature builders (gmail.service.ts, microsoft.service.ts) read that column
/// and are deliberately left untouched.
///
/// "One active number per company" is enforced by the DATABASE, not only the service:
/// `activeForCompanyId` holds the company id while live and is NULL once released. MySQL
/// treats NULLs as distinct in a unique index, so any number of released rows coexist while
/// two live rows for one company collide. This is the standard emulation of the partial
/// unique index MySQL lacks -- do NOT "simplify" it to a unique on `companyId`, which would
/// cap a company at one number for all time and break every re-provision.
///   `releasedAt`         -- what every query filters on (`releasedAt: null`)
///   `activeForCompanyId` -- never queried; exists only to make the constraint real
/// Both are always written in the same statement.
model SupportNumber {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  /// The company id while ACTIVE, NULL once released. Constraint column -- see above.
  activeForCompanyId Int?      @unique
  /// SignalWire IncomingPhoneNumber SID. Stored for two reasons:
  ///  1. Release and reconfigure are keyed by SID in the URL path
  ///     (`DELETE /IncomingPhoneNumbers/{Sid}`) -- there is no delete-by-number form. It is
  ///     derivable via `GET /IncomingPhoneNumbers?PhoneNumber=...`, but that would put a
  ///     network round-trip in front of the one operation that STOPS BILLING: if the lookup
  ///     fails, you cannot release, and the charge keeps running.
  ///  2. It is the safe global key. Minted per purchase and never reused, whereas SignalWire
  ///     can sell back a number we previously released -- which a unique phoneNumber would
  ///     reject with P2002 *after* the purchase was already billed.
  sid                String    @unique
  phoneNumber        String
  /// The region (province / state) the number was bought in, e.g. QC. This is the real
  /// geographic key: SignalWire IGNORES the country segment in the search URL, and its
  /// `iso_country` field reports "US" even for Montreal numbers, so neither can be trusted.
  region             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// When the number was released on SignalWire (billing stopped). NOT a soft delete --
  /// the row is permanent history.
  releasedAt         DateTime?

  company Company @relation(fields: [companyId], references: [id], map: "fk_support_number_company")

  @@index([companyId, releasedAt], map: "idx_support_number_company")
  @@index([phoneNumber], map: "idx_support_number_phone")
}

// ─── Phone hours & caller-facing messages ────────────────────────────────────

/// The ONE row of global phone defaults, inherited by every company that does not
/// override a field. Every column is NOT NULL: this is the bottom of the resolution
/// chain, so a NULL here would have nothing left to fall back to.
///
/// The singleton is enforced by the DATABASE, not by convention: `singleton` is a unique
/// column with exactly one legal value, and every access goes through
/// `upsert({ where: { singleton: 'GLOBAL' } })`. Two concurrent first-writes then collide
/// on P2002 instead of quietly creating a second row that half the requests would read.
/// `id Int @id @default(1)` does NOT do this -- autoincrement will happily mint id 2.
model PhoneSettingsDefault {
  id        Int    @id @default(autoincrement())
  singleton String @unique @default("GLOBAL")

  /// IANA zone the weekly hours are read in, e.g. "America/Toronto". Validated on write
  /// against the ICU database itself, never a hardcoded list -- a list would drift from
  /// the one the resolver actually uses.
  timezone String @default("America/Toronto")

  /// The week: a 7-element JSON array indexed 0=Sun..6=Sat (the same convention as
  /// TaskSchedule.cycleDay and WEEKDAYS in client/src/lib/cycle.ts). Each element is
  /// `{"open":"09:00","close":"17:00"}` or `null` for closed all day.
  ///
  /// ONE value, not 14 columns and not a child table: the week is edited as a grid and
  /// inherited as a unit. A per-weekday layout would make "Monday inherits, Tuesday
  /// overrides" representable while being impossible to explain in a UI. The cost -- no
  /// DB-level typing -- is paid by parseWeeklyHours(), which the write validator also
  /// calls, so there is exactly one definition of the shape.
  weeklyHours Json

  /// Caller-facing text. `{company name}` / `{phone}` / `{hours}` are substituted by
  /// phone-message.util.ts. Stored PLAIN -- XML escaping happens once, in laml.util.ts.
  greetingMessage   String @db.Text
  afterHoursMessage String @db.Text

  /// Said when there is nobody to ring: unknown number, no assignee and no admins, or an
  /// unconfigured softphone. Replaces the hardcoded HOLDING_MESSAGE.
  unavailableMessage String @db.Text

  /// Whether the greeting plays BEFORE the phone starts ringing.
  playGreeting Boolean @default(true)

  /// true  = after hours, play the message and hang up.
  /// false = play the message, then ring anyway.
  afterHoursHangUp Boolean @default(true)

  /// MASTER SWITCH, default FALSE. Off means hours are ignored and every call rings --
  /// byte-for-byte the behaviour that shipped before this feature. That is what lets it
  /// deploy inert with no coordinated cutover, and it is the one-click rollback.
  hoursEnabled Boolean @default(false)

  /// Seconds <Dial> rings before giving up. Was hardcoded 30 in the webhook.
  ringTimeoutSeconds Int @default(30)

  /// <Say voice="..."> value. "" means omit the attribute and take the provider default --
  /// on THIS table "" is the only way to say that, because NULL is not available.
  voice String @default("")

  /// PhoneAudio.id of the track a caller hears while on hold. 0 means NONE -- silence.
  /// 0 rather than NULL because on the per-company table NULL already means "inherit",
  /// so it cannot also mean "none". Same shape as `voice = ""` above. No FK: 0 has no row
  /// to point at, and deleting a track must degrade a company to silence rather than
  /// block the delete or break a live call.
  holdAudioId Int @default(0)

  /// MASTER SWITCH for voicemail. Default TRUE: a caller who reaches nobody can leave a
  /// message rather than having the line dropped on them.
  ///
  /// It shipped as FALSE, on the inert-by-default rule hoursEnabled still follows. That
  /// was wrong here -- the switch had no UI, so "inert by default" meant "unreachable",
  /// and every after-hours call hung up with no way to change it. Turning voicemail OFF
  /// is now the deliberate act, per company, in the settings UI.
  ///
  /// NOTE: this governs a FRESH install only. The defaults row is a singleton the seed
  /// never updates (`update: {}`), so an existing database keeps whatever it already has
  /// -- see scripts/enable-voicemail.mjs.
  voicemailEnabled Boolean @default(true)

  /// Said just before the beep. Runs through renderMessage, so {company name} works here
  /// like every other caller-facing message. Stored PLAIN -- escaped once in laml.util.ts.
  voicemailPrompt String @db.Text

  /// Ceiling on ONE message. <Record> bills per minute and stores on SignalWire, so a
  /// caller who sets the phone down otherwise records until the provider's own limit.
  voicemailMaxSeconds Int @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-company overrides. EVERY column is nullable and NULL means "inherit" -- there is no
/// third state and no `useDefault` flag beside each value, because two ways to express one
/// state eventually disagree and leave an unrepresentable combination to debug. Clearing an
/// override is SET NULL, never deleting the row.
///
/// NULL is the ONLY absence. "" and false and 0 are VALUES. The resolver therefore uses
/// `??`, never `||`: under `||` a `playGreeting: false` override silently reverts to the
/// global true.
///
/// A single shared table keyed `companyId Int? @unique` with NULL = the global row is the
/// obvious "clever" alternative and is WRONG here: MySQL treats NULLs as distinct in a
/// unique index (that is exactly the SupportNumber.activeForCompanyId trick), so it would
/// permit unlimited global rows -- and it would force every column nullable, destroying the
/// "the defaults row is complete" invariant above.
model CompanyPhoneSettings {
  id        Int @id @default(autoincrement())
  companyId Int @unique

  timezone           String?
  weeklyHours        Json?
  greetingMessage    String?  @db.Text
  afterHoursMessage  String?  @db.Text
  unavailableMessage String?  @db.Text
  playGreeting       Boolean?
  afterHoursHangUp   Boolean?
  hoursEnabled       Boolean?
  ringTimeoutSeconds Int?
  voice              String?

  /// NULL = inherit, 0 = explicitly none. Both are meaningful values, which is why the
  /// resolver must use `??` and never `||`.
  holdAudioId Int?

  voicemailEnabled    Boolean?
  voicemailPrompt     String?  @db.Text
  voicemailMaxSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_company_phone_settings_company")
}

/// An admin-uploaded audio track, played to a caller who has been put on hold.
///
/// Metadata only -- the bytes live on disk under UPLOADS_DIR/phone-audio/, following the
/// InternalMessageAttachment convention (original name in the DB, UUID on disk,
/// storagePath RELATIVE to the uploads root so UPLOADS_DIR stays relocatable).
///
/// Everything is transcoded to mono mp3 on upload, so mimeType is always "audio/mpeg" and
/// format compatibility stops being a runtime concern.
///
/// Soft-deleted, never hard-deleted: a settings row may still name this id, and those
/// columns carry no FK (see the 0 sentinel on PhoneSettingsDefault.holdAudioId).
model PhoneAudio {
  id       Int    @id @default(autoincrement())
  name     String // admin-facing label, editable
  filename String // original name as uploaded
  mimeType String
  size     Int

  /// Length of the stored mp3, measured by ffmpeg during the transcode itself.
  durationMs Int

  /// Path relative to the uploads root, e.g. "phone-audio/<uuid>.mp3".
  storagePath String

  uploadedById Int?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt], map: "idx_phone_audio_deleted")
}

/// One staff-to-staff call, placed browser to browser with no phone number involved.
///
/// This is the ONLY record that a given call was John calling Jack. Every browser
/// registers the SAME SIP credential (see phone.config.ts -- SIP passwords cannot be set
/// through any SignalWire API, so per-user endpoints would mean a manual dashboard entry
/// per employee), which means both legs of an internal call are the same address and
/// SignalWire cannot tell two internal calls apart. Ever.
///
/// That is a real departure from the rest of the phone module, which deliberately
/// persists nothing because a company's support number is stamped on the leg -- there,
/// the leg IS the evidence. Here the leg proves nothing, so this row is the evidence,
/// including for deciding who may play the recording back.
///
/// Written from authenticated facts at the moment the call is placed: the caller comes
/// from the JWT, the callee from the request body. Nothing is inferred.
model InternalCall {
  id Int @id @default(autoincrement())

  /// The leg the <Dial> ran on -- the parent. Recordings file against this sid.
  callSid String @unique

  /// Random per-call marker, sent as the X-Cyg-Call SIP header on the CALLEE's leg only.
  /// Both legs fork to every registered browser, and the client's pairing logic does not
  /// match on call sid -- without this marker the callee can answer the caller's own leg,
  /// intermittently, depending on timing. Never displayed.
  token String @unique

  callerId Int
  calleeId Int

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Filled in by the existing voice/status webhook, so listing call history costs zero
  /// SignalWire requests.
  status      String?
  durationSec Int?

  caller User @relation("InternalCallsMade", fields: [callerId], references: [id], map: "fk_internal_call_caller")
  callee User @relation("InternalCallsReceived", fields: [calleeId], references: [id], map: "fk_internal_call_callee")

  @@index([callerId, startedAt], map: "idx_internal_call_caller")
  @@index([calleeId, startedAt], map: "idx_internal_call_callee")
}

// ─── Assignments (User ↔ Company) ────────────────────────────────────────────

model Assignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  companyId  Int
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], map: "fk_assignment_user")
  company Company @relation(fields: [companyId], references: [id], map: "fk_assignment_company")

  @@unique([userId, companyId])
}

// ─── Tasks & Todos ───────────────────────────────────────────────────────────

model Task {
  id                Int       @id @default(autoincrement())
  title             String    @unique
  description       String?   @db.Text
  note              String?   @db.Text
  isGeneral         Boolean   @default(false)
  defaultCycle      Int       @default(30)
  defaultCycleType  CycleType @default(DAYS)
  defaultCycleDay   Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  defaultCycleNth   Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  isImportant       Boolean   @default(false)
  canBeDisabled     Boolean   @default(false)
  isSnoozable       Boolean   @default(false)
  orderNumber       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  todos     Todo[]
  schedules TaskSchedule[]
}

// Recurring schedule for a task assigned to a company.
// cycleType determines recurrence pattern; cycle is only used for DAYS type.
// deletedAt = soft-delete: stops future todo generation without deleting history.
model TaskSchedule {
  id          Int       @id @default(autoincrement())
  taskId      Int
  companyId   Int
  cycle       Int       @default(30) // days between recurrences (DAYS type only)
  cycleType   CycleType @default(DAYS)
  cycleDay    Int?      // MONTHLY_DATE/QUARTERLY/YEARLY: 1-28 or 0=last day of month | WEEKLY_DAY/MONTHLY_WEEKDAY: 0=Sun…6=Sat
  cycleNth    Int?      // MONTHLY_WEEKDAY only: 1=first … 4=fourth
  note        String?   @db.Text
  userNote    String?   @db.Text
  isImportant     Boolean   @default(false)
  isManuallyAdded Boolean   @default(false)
  startDate       DateTime?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  task    Task         @relation(fields: [taskId], references: [id], map: "fk_schedule_task")
  company Company      @relation(fields: [companyId], references: [id], map: "fk_schedule_company")
  todos   Todo[]
}

// ─── Company Notes ───────────────────────────────────────────────────────────

model CompanyNote {
  id        Int      @id @default(autoincrement())
  companyId Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "fk_company_note_company")
}

// ─── Links ───────────────────────────────────────────────────────────────────

model Link {
  id        Int     @id @default(autoincrement())
  companyId Int
  label     String
  // Optional: a link row is often just a credential store (username/password/note)
  // for a service with no single URL worth saving.
  url       String? @db.Text
  username  String?
  password  String? // stored AES-256 encrypted (ivHex:cipherHex) — never plaintext
  note      String? @db.Text
  // User-defined display order within a company, set by dragging. Ties break on id.
  sortOrder Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], map: "fk_link_company")

  @@index([companyId, sortOrder], map: "idx_link_company_order")
}

// ─── Internal messaging (staff ↔ staff) ──────────────────────────────────────

// One internal message. Behaves like an email: it has a subject, an HTML body,
// attachments, and lives in a thread. Unlike the Communications tab (which reads
// live from Google/Microsoft and persists nothing), these messages ARE the store.
model InternalMessage {
  id        Int       @id @default(autoincrement())
  // Root message id of the conversation. Set to the message's own id right after
  // create for a new thread, or inherited from the parent for a reply/forward.
  threadId  Int?
  // The message this one replies to or forwards. Null for a fresh message.
  parentId  Int?
  senderId  Int
  subject   String    @db.Text
  bodyHtml  String?   @db.Text
  bodyText  String?   @db.Text
  isForward Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  sender      User                        @relation(fields: [senderId], references: [id], map: "fk_internal_message_sender")
  recipients  InternalMessageRecipient[]
  attachments InternalMessageAttachment[]

  @@index([threadId], map: "idx_internal_message_thread")
  @@index([senderId, createdAt], map: "idx_internal_message_sender")
}

// Per-recipient delivery + state. Read/completed live HERE rather than in a shared
// table (cf. ChatMessageReadState / MessageCompletedState, which are deliberately
// shared per company) because every user has their own private internal inbox.
model InternalMessageRecipient {
  id          Int                   @id @default(autoincrement())
  messageId   Int
  userId      Int
  kind        InternalRecipientKind @default(TO)
  readAt      DateTime?
  completedAt DateTime?

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "fk_internal_msg_recipient_message")
  user    User            @relation(fields: [userId], references: [id], map: "fk_internal_msg_recipient_user")

  @@unique([messageId, userId], map: "uq_internal_msg_recipient")
  @@index([userId, completedAt], map: "idx_internal_msg_recipient_inbox")
}

// Attachment bytes live on disk under UPLOADS_DIR (see internal-messages.service);
// only the metadata + relative storagePath are stored here. This is the first
// thing in the app that persists a user-supplied file — every other upload
// (face photos, email attachments) is a pass-through to an external API.
model InternalMessageAttachment {
  id          Int      @id @default(autoincrement())
  messageId   Int
  filename    String // original name as uploaded, shown in the UI
  mimeType    String
  size        Int
  storagePath String // path relative to the uploads root, e.g. "messages/<uuid>.pdf"
  createdAt   DateTime @default(now())

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "fk_internal_msg_attachment_message")

  @@index([messageId], map: "idx_internal_msg_attachment_message")
}

// ─── Gmail Integration ───────────────────────────────────────────────────────

model GmailAccount {
  id            Int       @id @default(autoincrement())
  companyId     Int       @unique
  gmailAddress  String
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  tokenExpiry   DateTime
  lastHistoryId BigInt?
  watchExpiry   DateTime?
  connectedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  chatUserId    String?   // connected account's own Google Chat user id (OIDC `sub`), used to hide self-sent messages from the inbox
  scope         String?   @db.Text // space-separated list of OAuth scopes Google actually granted on the last connect (used to detect missing chat.messages)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_gmail_account_company")
}

// Connected Microsoft (Outlook + Teams) account for a company — the Microsoft
// analog of GmailAccount. A company has AT MOST ONE communications account: a row
// here OR in GmailAccount, never both. Which table has the row IS the provider.
// Tokens are AES-256 encrypted at the app layer (same crypto as GmailAccount).
model MicrosoftAccount {
  id           Int       @id @default(autoincrement())
  companyId    Int       @unique
  emailAddress String
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  tokenExpiry  DateTime
  msUserId     String?   // Graph /me id — self-hide analog of GmailAccount.chatUserId (hides self-sent Teams messages)
  scope        String?   @db.Text // space-separated list of Graph scopes actually granted on the last connect
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_ms_account_company")
}

// Shared per-MESSAGE read/unread state for Google Chat, per company.
// A message is READ iff a row exists for it. Shared across all users — when one
// user reads a chat message it is read for everyone, like the shared mailbox.
model ChatMessageReadState {
  id        Int      @id @default(autoincrement())
  companyId Int
  // VarChar(500), not Prisma's default VARCHAR(191): provider message ids are far
  // longer than Gmail's ~16-char hex. Under STRICT_TRANS_TABLES an over-long value
  // is an error (1406), not a truncation, so the INSERT throws and the state is
  // silently lost. Index still fits: 4 (INT) + 500*4 = 2004 bytes < InnoDB's 3072.
  messageId String   @db.VarChar(500) // Google Chat message resource name, e.g. "spaces/A/messages/B"
  readAt    DateTime
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_chat_msg_read_state_company")

  @@unique([companyId, messageId], map: "uq_chat_msg_read_state")
}

// Shared per-MESSAGE "completed" state for the Communications inbox (email + chat),
// per company. A message is COMPLETED iff a row exists for it. Shared across all
// users — when one user marks a message complete it is complete for everyone.
// The messageId is a provider-namespaced message id: a Gmail message id (no
// slashes), a Google Chat resource name (e.g. "spaces/A/messages/B"), an Outlook
// message id, or a Teams chat message id prefixed "msteams:{chatId}:{messageId}".
// Namespacing keeps email and chat ids from colliding across providers.
model MessageCompletedState {
  id          Int      @id @default(autoincrement())
  companyId   Int
  // See ChatMessageReadState.messageId — VARCHAR(191) was too narrow for Outlook
  // restIds, so marking an Outlook email complete threw and appeared to "not stick".
  messageId   String   @db.VarChar(500)
  completedAt DateTime
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_msg_completed_state_company")

  @@unique([companyId, messageId], map: "uq_msg_completed_state")
}

// Shared per-company forward event log — one row per time an inbox message was
// forwarded (from within the app), carrying the recipient and the moment. A
// message forwarded N times has N rows; forwarded iff at least one row exists.
// Accessed via raw SQL in gmail.service.ts.
model ForwardedMessageState {
  id          Int      @id @default(autoincrement())
  companyId   Int
  // See ChatMessageReadState.messageId — same VARCHAR(191) ceiling.
  messageId   String   @db.VarChar(500)
  recipient   String?  @db.Text
  // Id of the NEW message that was sent for this forward (Gmail message id /
  // Outlook immutable message id). Lets the UI open the full sent forward.
  // Null for legacy rows recorded before this was captured.
  sentMessageId String? @db.Text
  forwardedAt DateTime
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "fk_msg_forwarded_state_company")

  @@index([companyId, messageId], map: "idx_msg_forwarded_state")
}

// Individual todo instance. scheduleId is set when generated by a TaskSchedule.
// Standalone (one-time) todos have scheduleId = null.
model Todo {
  id         Int       @id @default(autoincrement())
  taskId     Int
  companyId  Int
  scheduleId Int?
  dueDate    DateTime?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     Task          @relation(fields: [taskId], references: [id], map: "fk_todo_task")
  company  Company       @relation(fields: [companyId], references: [id], map: "fk_todo_company")
  schedule TaskSchedule? @relation(fields: [scheduleId], references: [id], map: "fk_todo_schedule")
}

